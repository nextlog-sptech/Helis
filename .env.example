# ========================================================
# HELIS - Variáveis de Ambiente para Docker e Local
# Copie este arquivo para .env: cp .env.example .env
# Defina senhas seguras para DB_PASSWORD e DB_ROOT_PASSWORD
# ========================================================

# Configuração de Ambiente (producao ativa o .env com host do Docker)
AMBIENTE_PROCESSO=producao

# Configurações do Banco de Dados MySQL
DB_HOST=banco
DB_PORT=3306
DB_DATABASE=helis
DB_USER=helis_user
DB_PASSWORD=sua_senha_forte_aqui
DB_ROOT_PASSWORD=sua_senha_root_forte_aqui

# Configurações do Servidor da Aplicação
APP_PORT=3333
APP_HOST=0.0.0.0
